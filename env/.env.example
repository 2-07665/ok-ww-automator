# Account configuration
# Copy to env/<account>.env for scheduler discovery, or env/.env for the default account.
# For standalone commands, ENV_FILE can select another env file.
# Process environment values override this file.
# Windows Task Scheduler should launch the scheduler module, not set ENV_FILE.

# --- Game ---
# Server: CN, US, EU, ASIA, SEA, HMT. Required for weekly mode.
GAME_SERVER=CN

# Path to Wuthering Waves.exe. Required only before launching the game.
GAME_EXE_PATH=D:\Games\Wuthering Waves\Wuthering Waves Game\Wuthering Waves.exe

# Resource mode: sd (流畅), hd (高清, default), uhd (极致). Match installed resources.
# An uninstalled mode can automatically download several GB.
GAME_RESOURCE_QUALITY=hd

# --- Schedule and retries ---
# Daily: assumed time when the task will run, in UTC+08.
# Used for stamina prediction and burn decisions.
DAILY_HOUR=5
DAILY_MINUTE=0

# Weekly Garden: trigger time is controlled by Windows Task Scheduler.
# Allowed server calendar weekdays per account; omitted/blank means every day.
WEEKLY_RUN_DAYS=1,2,3,4,5,6,7
# Notify if still unsuccessful on/after this weekday (server time).
# 1=Monday ... 7=Sunday; weeks reset Monday 04:00.
WEEKLY_NOTICE_DAY=7

# Retry failed runs.
RETRY_MAX_ATTEMPTS=2
RETRY_DELAY_SECONDS=30

# --- Google Sheets ---
# Required for live Sheets reads/writes.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Worksheet names
SHEET_NAME_CONFIG=Config
SHEET_NAME_DAILY=DailyRuns
SHEET_NAME_STAMINA=StaminaRuns
SHEET_NAME_FASTFARM=5to1

# --- Waves API (optional) ---
# Enable fast stamina checks; credentials are required when enabled.
WAVES_API_ENABLED=false
WAVES_ROLE_ID=
WAVES_TOKEN=
WAVES_DID=

# --- Notifications (optional) ---
NOTICE_ENABLED=false
# Comma-separated channels: mailgun, wxpusher
NOTICE_CHANNEL=
# Optional display label for multi-account notices, such as global or cn.
NOTICE_ACCOUNT_ID=
# Do not send post-run notices when the final task result is success or skipped.
NOTICE_SKIP_SUCCESS=false

# Mailgun channel credentials
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_RECIPIENT=

# WxPusher channel credentials (simple-push)
WXPUSHER_SPT=

# --- Healthchecks.io (optional) ---
# Requires UUID checks for both scheduled task types.
HEALTHCHECKS_ENABLED=false
HEALTHCHECKS_DAILY_UUID=
HEALTHCHECKS_STAMINA_UUID=
