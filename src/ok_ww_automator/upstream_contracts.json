    {
      "id": "runtime.isolation",
      "reason": "One OK runtime per attempt process; upstream globals/mutexes and cwd-relative assets prevent safe in-process account reuse. Verify startup, cancellation, timeout and native teardown on Windows."
    },
    {
      "id": "game.capture",
      "reason": "Verify connected device dictionaries expose imei/connected, real frames and interaction; registration/signature checks cannot prove live capture works."
    },
    {
      "id": "game.ui",
      "reason": "Verify 16:9 Chinese UI OCR regions, feature labels, echo stat tiers, merge confirmation and Cartethyia cooldowns after game updates. A merge with unknown submission status must never retry automatically."
    },
    {
      "id": "game.progress",
      "reason": "Check localized Error and Log keys, total daily points, Fight Count, and weekly completion in a current task; never treat historical logs or negative OCR as success."
    },
    {
      "id": "services",
      "reason": "Offline doctor does not call Google Sheets, Kuro/Waves, wxPusher, Mailgun or Healthchecks. Verify enabled integrations separately without exposing credentials; token/schema changes are independent of OK upstream."
    },
    {
      "id": "scheduler.time",
      "reason": "Stamina cap 240, backup cap 480, regeneration 6/12 minutes, daily hour UTC+8, weekly reset Monday 04:00 UTC+8. Windows triggers use host local time."
    },
    {
      "id": "launcher.contract",
      "reason": "Frozen launcher needs sibling .venv/Scripts/python.exe and source checkouts; its subprocess CLI and progress JSON must stay compatible. Rebuild after launcher/UI/progress/discovery contract changes."
    }
  ]
